 <office:body>
  <office:presentation>
   <draw:page draw:name="Slide1" draw:style-name="dp3" draw:master-page-name="Default" presentation:presentation-page-layout-name="AL1T0">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P7" draw:layer="layout" svg:width="7.65cm" svg:height="2.3cm" svg:x="4.5cm" svg:y="3.85cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T2">AgentiX</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr5" draw:text-style-name="P8" draw:layer="layout" svg:x1="1.35cm" svg:y1="6.55cm" svg:x2="4.35cm" svg:y2="6.55cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="15cm" svg:height="1.2cm" svg:x="1.35cm" svg:y="6.85cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T3">AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr6" draw:text-style-name="P10" draw:layer="layout" svg:width="14.6cm" svg:height="1.7cm" svg:x="1.35cm" svg:y="8.15cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T4">An experimental platform for AI-assisted software development.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr7" draw:text-style-name="P11" draw:layer="layout" svg:width="9.45cm" svg:height="7.9cm" svg:x="17.2cm" svg:y="3.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">What this talk covers</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">01 The problem: easy to generate, hard to trust</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">02 The idea: small reusable pieces</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">03 The control loop and human approval</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">04 Seeing inside a component</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">05 Where software is allowed to run</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">06 One example: spreadsheet analysis</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">07 Local AI, SDD and honest limits</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">08 The human dimension</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">01</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr9" draw:text-style-name="P13" draw:layer="layout" svg:width="2.937cm" svg:height="2.5cm" svg:x="1.563cm" svg:y="3.65cm">
     <draw:image draw:mime-type="image/png">
