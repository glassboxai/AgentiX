      <text:p text:style-name="P6"><text:span text:style-name="T7">AgentiX is part of </text:span><text:span text:style-name="T8"><text:a xlink:href="https://glassboxai.dev/" xlink:type="simple">The Glass Box AI Project</text:a></text:span><text:span text:style-name="T7">, an independent research and development initiative dedicated to building understandable, inspectable, and trustworthy Artificial Intelligence.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="1" presentation:class="page"/>
     <draw:frame presentation:style-name="pr3" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide2" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">01 · THE PROBLEM</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Easy to generate. Harder to trust.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">A working application can appear in minutes. The difficult questions start right after.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr11" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="7.4cm" svg:x="1.35cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">What AI can do now</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Turn a plain description into a working application.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">“</text:span><text:span text:style-name="T13">Read a spreadsheet, remove duplicates, flag unusual values, produce a report.”</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Minutes, not weeks. That is real progress.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr12" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="7.4cm" svg:x="10cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">What stays open</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Was it tested?</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Can we understand it?</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">What breaks when it changes?</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Who approves it?</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Where is it allowed to run?</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr13" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="7.4cm" svg:x="18.65cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">The real problem</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Not how to generate software.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">How to make AI-assisted development controlled, transparent and reusable.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.8cm" svg:x="1.35cm" svg:y="11.3cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Existing AI tools already provide serious quality and governance features. AgentiX is one architectural approximation to these questions, not a verdict on the tools that already exist.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">02</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="2" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide3" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">02 · THE IDEA</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Build with reusable pieces</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">The LEGO idea, with engineering attached.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="12.2cm" svg:height="6cm" svg:x="1.35cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">A Tool</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">One small capability with defined inputs and outputs.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Read a file · remove duplicates · standardise formats · detect anomalies · draw a chart</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Small enough to test, review and approve on its own.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="12.2cm" svg:height="6cm" svg:x="14.45cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">An Application</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Tools combined into one workflow.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The same Tool can be reused in other applications.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Build reusable capabilities instead of regenerating the same function.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.4cm" svg:x="1.35cm" svg:y="9.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T15">Modular design is not an AgentiX invention.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T15"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">The project applies established modular principles to an AI-assisted workflow — with testing, review and execution rules attached to every piece.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">03</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="3" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide4" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">03 · HUMAN CONTROL</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Nothing runs without a human decision</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Six steps between an idea and something that is allowed to execute.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="12.2cm" svg:height="2.55cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">01</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Generation</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">AI agents draft a component from the requested behaviour.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="12.2cm" svg:height="2.55cm" svg:x="14.45cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">02</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Verification</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Checked against defined requirements and acceptance tests.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="12.2cm" svg:height="2.55cm" svg:x="1.35cm" svg:y="6.15cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">03</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Human review</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">A developer inspects the component and its behaviour.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="12.2cm" svg:height="2.55cm" svg:x="14.45cm" svg:y="6.15cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">04</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Approval</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Authorised for use under the platform&apos;s approval rules.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="12.2cm" svg:height="2.55cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">05</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Reuse</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Approved components can be selected for new applications.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="12.2cm" svg:height="2.55cm" svg:x="14.45cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">06</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Controlled execution</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Running is subject to the platform&apos;s restrictions.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.8cm" svg:x="1.35cm" svg:y="11.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Being able to generate code is not the same as being authorised to use it. Approval is a control point, not a guarantee of correctness.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">04</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="4" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide5" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">04 · OBSERVABILITY</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">An application should not be a black box</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Component-level observability: see what each piece does, not only the final result.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.8cm" svg:x="1.35cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Inspect one Tool</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Each Tool can carry an interactive widget.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Give it an input, watch the output.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Behaviour becomes visible without reading code line by line.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.8cm" svg:x="10cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Follow the whole chain</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Combined into an application, the widgets show each processing step.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Not only the final result, but the intermediate transformations.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.8cm" svg:x="18.65cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">What it is not</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">It complements traditional debugging tools.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">It does not replace them.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr7" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.2cm" svg:x="1.35cm" svg:y="9.7cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T17">“</text:span><text:span text:style-name="T17">Developers should be able to see how individual components contribute to the final result.”</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">05</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="5" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide6" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">05 · WHERE IT RUNS</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Approved here, not approved everywhere</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Approvals can be tied to the environment in which software is authorised to run.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="6cm" svg:x="1.35cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">An identity per component</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Each Tool and Application can have a cryptographic identity derived from its protected content and contracts.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="6cm" svg:x="10cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Bound to a workstation</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Locally protected approval records plus device security can mean that software approved on one machine is not automatically authorised on another.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="6cm" svg:x="18.65cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">What it does not do</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">A hash does not bind software to a device.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Approval rules do not stop copied source code from running outside the platform.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.8cm" svg:x="1.35cm" svg:y="9.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Review before use is not the only question. Organisations may also need control over where, and under which conditions, software is authorised to run.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">06</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="6" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide7" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">06 · ONE EXAMPLE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">One simple example: spreadsheet analysis</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">A small business receives sales spreadsheets every week.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="4.2cm" svg:height="2.4cm" svg:x="1.35cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">01</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Read the file</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="4.2cm" svg:height="2.4cm" svg:x="6.35cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">02</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Remove duplicates</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="4.2cm" svg:height="2.4cm" svg:x="11.35cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">03</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Standardise formats</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="4.2cm" svg:height="2.4cm" svg:x="16.35cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">04</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Flag unusual values</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="4.2cm" svg:height="2.4cm" svg:x="21.35cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T16">05</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Build the report</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="0.8cm" svg:height="0.7cm" svg:x="5.55cm" svg:y="5.45cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T18">→</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="0.8cm" svg:height="0.7cm" svg:x="10.55cm" svg:y="5.45cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T18">→</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="0.8cm" svg:height="0.7cm" svg:x="15.55cm" svg:y="5.45cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T18">→</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="0.8cm" svg:height="0.7cm" svg:x="20.55cm" svg:y="5.45cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T18">→</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr19" draw:text-style-name="P17" draw:layer="layout" svg:width="12.2cm" svg:height="3.2cm" svg:x="1.35cm" svg:y="7.8cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Combined into one application</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The five Tools become a single workflow the team can run on every new spreadsheet.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr20" draw:text-style-name="P18" draw:layer="layout" svg:width="12.2cm" svg:height="3.2cm" svg:x="14.45cm" svg:y="7.8cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T19">The result</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T19"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">A clean summary the team can act on: duplicates gone, formats consistent, unusual values flagged.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.6cm" svg:x="1.35cm" svg:y="11.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">The demonstration shows what the audience can observe, not the Python behind it. Prerecorded, to protect a ten-minute slot.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">07</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="7" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide8" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">07 · DIFFERENTIATION</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Local AI and Spec-Driven Development</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">What AgentiX claims, and what it deliberately does not claim.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr19" draw:text-style-name="P17" draw:layer="layout" svg:width="12.2cm" svg:height="5.6cm" svg:x="1.35cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Local models</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Runs on local models through Ollama, including Qwen3-Coder 30B.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Less dependence on external services, more control over the environment, code can stay on local infrastructure.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Hardware and electricity still cost money.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="12.2cm" svg:height="5.6cm" svg:x="14.45cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Spec-Driven Development</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">SDD structures how requirements are defined, implemented and verified.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">AgentiX manages generation, review, approval, execution and reuse.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">They complement each other. AgentiX is not a replacement for SDD.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr21" draw:text-style-name="P16" draw:layer="layout" svg:width="25.3cm" svg:height="2.8cm" svg:x="1.35cm" svg:y="9.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">Stated as a hypothesis, not a result</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Reduced model requirements are a research hypothesis and an architectural objective. Local AI is not exclusive to AgentiX, and splitting a problem into smaller tasks does not guarantee that a smaller model solves it.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">08</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="8" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide9" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">08 · STATUS</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Implemented, objective, future</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">A prototype from an intensive AI programme, not a finished commercial product.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr22" draw:text-style-name="P18" draw:layer="layout" svg:width="8cm" svg:height="6.6cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T19">Implemented</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T19"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Functions that exist in the current version and can be demonstrated reliably.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Verified against the actual build before the presentation.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No feature is shown that is not operational.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="6.6cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Architectural objective</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Designed for, still requiring validation:</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">· device-bound approvals</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">· stronger execution enforcement</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">· reduced model requirements</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="6.6cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">Future work</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">· component discovery and reuse</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">· more reliable composition</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">· stronger verification</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">· integration with SDD</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">· comparative evaluation</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="10.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Known limitations, stated openly</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Dependence on the local model · integration complexity · developer expertise needed in review · testing and approval overhead · security and reliability still to be evaluated · no controlled benchmark against SDD.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">09</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="9" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide10" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">09 · WHY IT MATTERS</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Why this is worth exploring</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Not because the pieces are new, but because of how they are combined.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="1.5cm" svg:x="1.35cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Multi-agent AI</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="1.5cm" svg:x="10cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Task decomposition</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="1.5cm" svg:x="18.65cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Local AI</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="1.5cm" svg:x="1.35cm" svg:y="5.2cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Human-in-the-loop</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="1.5cm" svg:x="10cm" svg:y="5.2cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Software reusability</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr17" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="1.5cm" svg:x="18.65cm" svg:y="5.2cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Controlled execution</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr19" draw:text-style-name="P17" draw:layer="layout" svg:width="25.3cm" svg:height="3.4cm" svg:x="1.35cm" svg:y="7.2cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">The honest question</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Can this workflow be integrated, practical and effective enough to justify its extra complexity? That is still being evaluated.</text:span></text:p>
      <text:p text:style-name="P19"><text:span text:style-name="T13">AgentiX does not compete on generation speed. For a simple application, a conventional AI assistant may be the better choice.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.6cm" svg:x="1.35cm" svg:y="11cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">The individual ideas are not new. What is being explored is their integration into a single platform.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">10</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="10" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide11" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">10 · CLOSING</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">AI should empower developers</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Different roles. Shared responsibility. Human expertise remains essential.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">For junior developers</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Small components to read, test and question.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Learning through review instead of guessing at a large generated codebase.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">For experienced developers</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Architecture, security, quality, integration and approval decisions.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The work that needs judgement.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">What it does not promise</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No elimination of defects, no guaranteed productivity gain, no automatic job preservation. Those outcomes need evaluation.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P21" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P20"><text:span text:style-name="T17">“</text:span><text:span text:style-name="T17">The future of AI-assisted software development is not just about generating more code, faster. It is about creating software we can understand, control and trust.”</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">11</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="14.6cm" svg:height="0.8cm" svg:x="1.3cm" svg:y="12.2cm">
     <draw:text-box>
      <text:p text:style-name="P22"><text:span text:style-name="T20">AgentiX is part of </text:span><text:span text:style-name="T21"><text:a xlink:href="https://glassboxai.dev/" xlink:type="simple">The Glass Box AI Project</text:a></text:span><text:span text:style-name="T22"><text:s/></text:span><text:span text:style-name="T23">· AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="11" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide12" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">12</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P7" draw:layer="layout" svg:width="6.5cm" svg:height="2.3cm" svg:x="10cm" svg:y="6.7cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T2">Thanks.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="12" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page13" draw:style-name="dp4" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">11 · THE AGENTS</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Nine agents, two separate teams</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">The architecture document counts them, names them and states what each one may do.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Tool-creation crew · six roles</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Engineering Manager</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Creation Manager, a tool-free twin</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Installed Application Advisor</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Software Architect</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Senior Python Coder</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">QA Automation Engineer</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Application crew · three roles</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Application planner</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Application integrator</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Application widget designer</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Built per generation, with no tools, no delegation and no code execution.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">What none of them may do</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No agent calls another agent.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No agent approves its own work.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No agent writes outside the working directory.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No agent runs code that was not approved.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Eleven other names in the same package are not CrewAI agents at all: model clients, coordinators, validators and executors. The document separates them explicitly so the roster cannot be inflated.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">12</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp4">
     <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="13" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.365cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide13" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">12 · TOOL CREATION</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">A tool is built in three gated stages</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Each stage is one agent. Between stages the host checks the file, not the sentence.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">1 · Specification</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The Software Architect writes what the tool must do.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The host confirms the file was really written and that its hash matches the write receipt.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">2 · Code</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The Senior Python Coder implements, compiles and saves.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">A syntax error keeps its turn open. The host re-checks the hash and compiles again.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr22" draw:text-style-name="P18" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T19">3 · Acceptance</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T19"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The QA Automation Engineer writes and runs the tests, then submits the cases for human review.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The host requires a fresh test receipt and an unchanged code file.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">The final answer is read from the evidence ledger, not from the manager&apos;s text. If no verified execution was recorded, the workflow says so instead of inventing a result.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">13</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="14" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide14" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">13 · APPLICATIONS</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Applications are composed from approved parts</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Nothing is generated freely. The catalog is resolved before the first model call.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Only approved tools</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">A tool without a current approval, or one that is not computation-only, stops the run before any model call.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Plan, then review</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The planner writes the connection code. The integrator checks every input source and port type against the approved contracts.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Only the integrator&apos;s output is validated and kept.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">Then a human decides</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Review text and identity are shown before approval.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Approval re-checks the acceptance cases and the host requirements. Verification runs before publication.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">The application crew receives schemas and feedback as data, never a filesystem path. A rejected review never triggers an automatic repair: the next attempt is a new human operation.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">14</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="15" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide15" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">14 · CONTRACTS</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Twenty-two contracts, one evidence ledger</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Every exchange between agents, tasks and services has a named producer, consumer and format.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Typed where it matters</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Decisions, tool schemas, application code and widget proposals are strict models.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Extra fields are rejected, not ignored.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Prompts are not the boundary</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The document separates what a prompt asks for from what Python enforces.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Nine instructions are listed as prompt-only, with no host check behind them.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">No retries by default</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Agent retry limit zero, model retries zero, guardrail retries zero.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">An application gets two repairs, then a new operation is required.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Model configuration is documented per construction site: temperature, timeout, token ceiling and concurrency gate. There is no model fallback anywhere in the agent path.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">15</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="16" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide16" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">15 · WHAT REMAINS OPEN</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Evidence, and what is still unverified</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Every claim carries a label, so a reader knows how much weight it holds.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr22" draw:text-style-name="P18" draw:layer="layout" svg:width="8cm" svg:height="5.8cm" svg:x="1.35cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T19">Confirmed</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T19"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Nine agents, twenty-two contracts, six diagrams.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Each one traced to a file and a symbol in the current source.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.8cm" svg:x="10cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Inferred</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Logically derived but not directly verified.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Field-level bounds of two models are cited by location rather than restated.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.8cm" svg:x="18.65cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">Unverified</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Delegation and memory defaults left to the framework.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Crew cache behaviour, and how the system behaves under a live model.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr7" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.2cm" svg:x="1.35cm" svg:y="9.7cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T17">&quot;No agent, contract or workflow was invented to fill a gap. What could not be verified is reported as unverified.&quot;</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">16</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="17" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide17" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">16 · TOOL RETRIEVAL</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Finding the right Tool before building</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">The catalog is searched, never trusted: retrieval proposes candidates, the owner decides.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">Lexical · BM25</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Exact words and identifiers, scored with k1 1.5 and b 0.75.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Rebuilt in memory on every search; nothing is persisted.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Semantic · embeddings</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">A local Ollama model turns each Tool description into a vector.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Cosine similarity ranks meaning, not spelling.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">Fusion · RRF</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Two ranked lists merged with 1/(60+rank), equal weight.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No thresholds, no weights, no reranker.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Both branches read the same stored documents, so one search never compares two different catalogs. The subsystem lives in its own package and imports no agent framework.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">17</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="17" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide18" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">17 · THE INDEX</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">A disposable index, an authoritative catalog</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">The vector store holds descriptors and vectors. It never holds approval, code or grants.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">What is indexed</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Nine descriptor fields: name, description, entrypoint, both schemas, keywords, digest.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">One JSON record and one vector per Tool.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">What is not</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No approval status, no tags, no version, no source path, no test bytes.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Those live in the catalog and the approval ledger.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">How it stays current</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">A bounded AST snapshot is reconciled before every search.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Added, updated and removed Tools are counted and logged.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Deleting the index loses only cached descriptors and vectors. The next synchronization rebuilds them from the installed Tools, and a failed scan is never mistaken for an empty catalog.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">18</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="18" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide19" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">18 · RANKING</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Two rankings, one fused list</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Scores order candidates. They are not probabilities and they are not permissions.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">BM25</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">idf · tf · (k1+1) / (tf + k1 · norm)</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Length-normalised term frequency over the same documents.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Cosine</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">similarity = 1 − distance</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Values are not clamped; a negative score is possible.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">Reciprocal rank fusion</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">score = Σ 1 / (60 + rank)</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">One-based ranks, ties broken by Tool identifier.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Ranking is deterministic for a fixed index, fixed providers and a fixed query. Two identical searches return the same order, and a Tool ranked first by both branches scores 2/61.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">19</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="19" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide20" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">19 · CONTROL</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">Retrieved is not approved</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Every candidate is shown with its eligibility, and acceptance binds exact bytes.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr22" draw:text-style-name="P18" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T19">Eligible</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T19"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Current reusable approval, acceptance context, portable imports, canonical contract.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Shown as a label, never used to hide a candidate.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">Accepted</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">The owner ticks an explicit subset; the server holds the revision and the digests.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">A stale or foreign selection cannot generate.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">Rechecked</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Source hashes are compared before generation and again at review.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Changed bytes invalidate the acceptance.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr7" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.2cm" svg:x="1.35cm" svg:y="9.7cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T17">&quot;Retrieval returns metadata. The executable bytes come from the approval ledger, keyed by name and re-hashed.&quot;</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">20</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="20" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide21" draw:style-name="dp3" draw:master-page-name="Default">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:rect draw:style-name="gr3" draw:text-style-name="P5" draw:layer="layout" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="24cm" svg:height="0.5cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T9">20 · WHAT IS NOT THERE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="1.3cm" svg:x="1.35cm" svg:y="1.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T10">What the architecture does not contain</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="25.3cm" svg:height="0.85cm" svg:x="1.35cm" svg:y="2.5cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T11">Absent mechanisms are recorded as absent, not implied by a diagram.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr14" draw:text-style-name="P15" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="1.35cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T12">No reranker</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No cross-encoder and no learned reordering stage.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Fusion is the last ranking step.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr15" draw:text-style-name="P17" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="10cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T4">No threshold</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T4"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">No similarity cutoff and no relevance floor.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">Every fused candidate is returned up to the limit.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr18" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="5.2cm" svg:x="18.65cm" svg:y="3.4cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T14">No tuning surface</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">RRF constant, BM25 parameters and branch budget are code constants.</text:span></text:p>
      <text:p text:style-name="P6"><text:span text:style-name="T13">They are not a runtime configuration API.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr16" draw:text-style-name="P11" draw:layer="layout" svg:width="25.3cm" svg:height="2.6cm" svg:x="1.35cm" svg:y="8.9cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T5">Also absent: a persistent lexical index, a filesystem watcher and any multi-process coordination of the index. Index writes are not transactional, and the next synchronization retries a partial one.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:line draw:style-name="gr8" draw:text-style-name="P12" draw:layer="layout" svg:x1="1.35cm" svg:y1="14.95cm" svg:x2="26.65cm" svg:y2="14.95cm">
     <text:p/>
    </draw:line>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="16cm" svg:height="0.4cm" svg:x="1.35cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">AgentiX — AI Builds. Humans Control.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P9" draw:layer="layout" svg:width="2.25cm" svg:height="0.4cm" svg:x="24.4cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P6"><text:span text:style-name="T6">21</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr10" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="21" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:text-style-name="P14" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <presentation:settings presentation:mouse-visible="false"/>
  </office:presentation>
 </office:body>
</office:document>