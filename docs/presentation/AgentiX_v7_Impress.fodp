    <draw:frame draw:name="Editable card title" draw:style-name="gr14" draw:text-style-name="P20" draw:layer="layout" svg:width="6.1cm" svg:height="0.889cm" svg:x="20.55cm" svg:y="2.75cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T9">2:00 RUN OF SHOW</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Editable card body" draw:style-name="gr39" draw:text-style-name="P18" draw:layer="layout" svg:width="6.1cm" svg:height="8.3cm" svg:x="20.55cm" svg:y="3.5cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">00:00 Catalog + approval state</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">00:25 Select reusable tools</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">00:50 Review connection code</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">01:20 Run approved app</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">01:45 Inspect result</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:frame draw:name="Speaker notes" draw:style-name="gr8" draw:text-style-name="P13" draw:layer="layout" svg:width="24cm" svg:height="12cm" svg:x="1cm" svg:y="1cm">
      <draw:text-box>
       <text:p text:style-name="P8"><text:span text:style-name="T5">Timing: 02:00 reserved. No recording was supplied. This is an editable placeholder only. Before recording, confirm the current approved state, interfaces and authorized GUI instance; do not use historical screenshots as evidence of the live UI.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide 10" draw:style-name="dp3" draw:master-page-name="Predeterminado">
    <draw:rect draw:name="Editable dark background" draw:style-name="gr3" draw:text-style-name="P7" draw:layer="layout" svg:width="28.222cm" svg:height="15.875cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Section label" draw:style-name="gr6" draw:text-style-name="P11" draw:layer="layout" svg:width="24.5cm" svg:height="0.693cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T4">ENGINEERING CHALLENGES</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Slide title" draw:style-name="gr9" draw:text-style-name="P14" draw:layer="layout" svg:width="25cm" svg:height="1.478cm" svg:x="1.35cm" svg:y="1.1cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T6">Three engineering lessons from integration work</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Footer" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="24cm" svg:height="0.693cm" svg:x="1.35cm" svg:y="15.1cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">THE GLASS BOX AI PROJECT / AGENTIX V7</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Slide number" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="0.9cm" svg:height="0.693cm" svg:x="26cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">10</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:rect draw:name="Editable lesson card" draw:style-name="gr10" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="8.6cm" svg:x="1.2cm" svg:y="3cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Lesson title" draw:style-name="gr40" draw:text-style-name="P20" draw:layer="layout" svg:width="7.2cm" svg:height="0.9cm" svg:x="1.6cm" svg:y="3.3cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T9">01 ACCEPTANCE ORACLES</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson label" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="7.2cm" svg:height="0.693cm" svg:x="1.6cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">CHALLENGE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson text" draw:style-name="gr35" draw:text-style-name="P18" draw:layer="layout" svg:width="7.2cm" svg:height="1.429cm" svg:x="1.6cm" svg:y="5.02cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Proposed tests and expected values were sometimes wrong.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson label" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="7.2cm" svg:height="0.693cm" svg:x="1.6cm" svg:y="6.4cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">RESPONSE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson text" draw:style-name="gr35" draw:text-style-name="P18" draw:layer="layout" svg:width="7.2cm" svg:height="1.429cm" svg:x="1.6cm" svg:y="6.82cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Keep independent expectations host-held; require human review.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson label" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="7.2cm" svg:height="0.693cm" svg:x="1.6cm" svg:y="8.5cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">LESSON</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson text" draw:style-name="gr35" draw:text-style-name="P18" draw:layer="layout" svg:width="7.2cm" svg:height="1.429cm" svg:x="1.6cm" svg:y="8.92cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Test success is provisional; the oracle must be independent.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:rect draw:name="Editable lesson card" draw:style-name="gr13" draw:text-style-name="P19" draw:layer="layout" svg:width="8cm" svg:height="8.6cm" svg:x="10.15cm" svg:y="3cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Lesson title" draw:style-name="gr40" draw:text-style-name="P17" draw:layer="layout" svg:width="7.2cm" svg:height="0.9cm" svg:x="10.55cm" svg:y="3.3cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T8">02 FRAMEWORK REALITY</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson label" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="7.2cm" svg:height="0.693cm" svg:x="10.55cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">CHALLENGE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson text" draw:style-name="gr41" draw:text-style-name="P18" draw:layer="layout" svg:width="7.2cm" svg:height="2.018cm" svg:x="10.55cm" svg:y="5.02cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Generated widgets invented Gradio APIs and mishandled callbacks.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson label" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="7.2cm" svg:height="0.693cm" svg:x="10.55cm" svg:y="6.8cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">RESPONSE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson text" draw:style-name="gr35" draw:text-style-name="P18" draw:layer="layout" svg:width="7.2cm" svg:height="1.429cm" svg:x="10.508cm" svg:y="7.254cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Use typed contracts and actual framework/browser checks.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson label" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="7.2cm" svg:height="0.693cm" svg:x="10.55cm" svg:y="8.5cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">LESSON</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson text" draw:style-name="gr41" draw:text-style-name="P18" draw:layer="layout" svg:width="7.2cm" svg:height="2.018cm" svg:x="10.55cm" svg:y="8.92cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Verify against the real framework, not prompt confidence.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:rect draw:name="Editable lesson card" draw:style-name="gr10" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="8.6cm" svg:x="19.1cm" svg:y="3cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Lesson title" draw:style-name="gr40" draw:text-style-name="P31" draw:layer="layout" svg:width="7.2cm" svg:height="0.9cm" svg:x="19.5cm" svg:y="3.3cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T17">03 RUN-TIME BOUNDARIES</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson label" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="7.2cm" svg:height="0.693cm" svg:x="19.5cm" svg:y="4.6cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">CHALLENGE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson text" draw:style-name="gr41" draw:text-style-name="P18" draw:layer="layout" svg:width="7.2cm" svg:height="2.018cm" svg:x="19.5cm" svg:y="5.02cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Compositions must remain reviewable without agents at run time.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson label" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="7.2cm" svg:height="0.693cm" svg:x="19.5cm" svg:y="6.8cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">RESPONSE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson text" draw:style-name="gr41" draw:text-style-name="P18" draw:layer="layout" svg:width="7.2cm" svg:height="2.018cm" svg:x="19.5cm" svg:y="7.22cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Generate connection code; approve exact bytes; use native worker.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson label" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="7.2cm" svg:height="0.693cm" svg:x="19.5cm" svg:y="9cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">LESSON</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Lesson text" draw:style-name="gr35" draw:text-style-name="P18" draw:layer="layout" svg:width="7.2cm" svg:height="1.429cm" svg:x="19.5cm" svg:y="9.42cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Autonomy belongs in proposal, not authorization.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:frame draw:name="Speaker notes" draw:style-name="gr8" draw:text-style-name="P13" draw:layer="layout" svg:width="24cm" svg:height="12cm" svg:x="1cm" svg:y="1cm">
      <draw:text-box>
       <text:p text:style-name="P8"><text:span text:style-name="T5">Timing: 00:55. These challenges are grounded in retained engineering reports: independent expectations corrected mistaken proposals; generated widgets used nonexistent Gradio interfaces; and V5-043 keeps generated connection code reviewable so running an approved package does not call agents. These are scoped lessons, not claims every issue is solved.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide 11" draw:style-name="dp3" draw:master-page-name="Predeterminado">
    <draw:rect draw:name="Editable dark background" draw:style-name="gr3" draw:text-style-name="P7" draw:layer="layout" svg:width="28.222cm" svg:height="15.875cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Section label" draw:style-name="gr6" draw:text-style-name="P11" draw:layer="layout" svg:width="24.5cm" svg:height="0.693cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T4">CONCLUSIONS &amp; NEXT STEPS</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Slide title" draw:style-name="gr9" draw:text-style-name="P14" draw:layer="layout" svg:width="25cm" svg:height="1.478cm" svg:x="1.35cm" svg:y="1.1cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T6">Make AI-assisted development inspectable and reusable</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Footer" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="24cm" svg:height="0.693cm" svg:x="1.35cm" svg:y="15.1cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">THE GLASS BOX AI PROJECT / AGENTIX V7</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Slide number" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="0.9cm" svg:height="0.693cm" svg:x="26cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">11</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:rect draw:name="Editable card" draw:style-name="gr23" draw:text-style-name="P28" draw:layer="layout" svg:width="8cm" svg:height="6.8cm" svg:x="1.2cm" svg:y="3cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Editable card title" draw:style-name="gr11" draw:text-style-name="P31" draw:layer="layout" svg:width="7.3cm" svg:height="0.84cm" svg:x="1.55cm" svg:y="3.25cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T17">IMPLEMENTED</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Editable card body" draw:style-name="gr42" draw:text-style-name="P18" draw:layer="layout" svg:width="7.3cm" svg:height="5.6cm" svg:x="1.55cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Tool proposals + review</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Independent acceptance gates</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Approved catalog reuse</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Generated app connection code</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Windows native execution</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:rect draw:name="Editable card" draw:style-name="gr22" draw:text-style-name="P26" draw:layer="layout" svg:width="8cm" svg:height="6.8cm" svg:x="10.1cm" svg:y="3cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Editable card title" draw:style-name="gr11" draw:text-style-name="P17" draw:layer="layout" svg:width="7.3cm" svg:height="0.84cm" svg:x="10.45cm" svg:y="3.25cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T8">BOUNDARIES</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Editable card body" draw:style-name="gr42" draw:text-style-name="P18" draw:layer="layout" svg:width="7.3cm" svg:height="5.6cm" svg:x="10.45cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Finite tests are not proof</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">No general third-party runtime</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Data-science workflow is planned</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Current GUI state is not asserted</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:rect draw:name="Editable card" draw:style-name="gr10" draw:text-style-name="P16" draw:layer="layout" svg:width="8cm" svg:height="6.8cm" svg:x="19cm" svg:y="3cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Editable card title" draw:style-name="gr14" draw:text-style-name="P20" draw:layer="layout" svg:width="7.3cm" svg:height="0.889cm" svg:x="19.35cm" svg:y="3.25cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T9">NEXT</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Editable card body" draw:style-name="gr42" draw:text-style-name="P18" draw:layer="layout" svg:width="7.3cm" svg:height="5.6cm" svg:x="19.35cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Broaden reviewed cases</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Verify richer workflows end to end</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Keep human decisions explicit</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Document current evidence</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Closing statement" draw:style-name="gr5" draw:text-style-name="P10" draw:layer="layout" svg:width="22cm" svg:height="1.131cm" svg:x="3cm" svg:y="10.7cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T3">AgentiX is designed to assist developers—not replace them.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="GitHub URL" draw:style-name="gr14" draw:text-style-name="P20" draw:layer="layout" svg:width="11cm" svg:height="0.889cm" svg:x="3cm" svg:y="12.1cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T9">https://github.com/glassboxai</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Project URL" draw:style-name="gr14" draw:text-style-name="P20" draw:layer="layout" svg:width="10cm" svg:height="0.889cm" svg:x="16cm" svg:y="12.1cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T9">https://glassboxai.dev/</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:frame draw:name="Speaker notes" draw:style-name="gr8" draw:text-style-name="P13" draw:layer="layout" svg:width="24cm" svg:height="12cm" svg:x="1cm" svg:y="1cm">
      <draw:text-box>
       <text:p text:style-name="P8"><text:span text:style-name="T5">Timing: 00:45. Close with implemented capabilities, explicit limits and future priorities. Distinguish historical scoped demonstrations from the current live instance. Developers retain responsibility.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <presentation:settings presentation:mouse-visible="false"/>
  </office:presentation>
 </office:body>
</office:document>