     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T9">4 NATIVE ISOLATION</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Editable card body" draw:style-name="gr11" draw:text-style-name="P18" draw:layer="layout" svg:width="23.9cm" svg:height="0.84cm" svg:x="2.15cm" svg:y="8.8cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Windows AppContainer + Job Object; no ordinary-host fallback.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:rect draw:name="Editable card" draw:style-name="gr10" draw:text-style-name="P16" draw:layer="layout" svg:width="24.6cm" svg:height="0.889cm" svg:x="1.8cm" svg:y="9.75cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Editable card title" draw:style-name="gr14" draw:text-style-name="P20" draw:layer="layout" svg:width="23.9cm" svg:height="0.889cm" svg:x="2.15cm" svg:y="9.75cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T9">5 OBSERVABILITY</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Editable card body" draw:style-name="gr11" draw:text-style-name="P18" draw:layer="layout" svg:width="23.9cm" svg:height="0.84cm" svg:x="2.15cm" svg:y="10.5cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Bounded host-checked results and technical events.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Security limitation" draw:style-name="gr32" draw:text-style-name="P17" draw:layer="layout" svg:width="24.6cm" svg:height="0.85cm" svg:x="1.8cm" svg:y="11.7cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T8">LIMIT: Finite cases can miss defects. Approval is not proof of correctness; isolation does not eliminate risk.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:frame draw:name="Speaker notes" draw:style-name="gr8" draw:text-style-name="P13" draw:layer="layout" svg:width="24cm" svg:height="12cm" svg:x="1cm" svg:y="1cm">
      <draw:text-box>
       <text:p text:style-name="P8"><text:span text:style-name="T5">Timing: 00:55. Explain the distinction between review, exact authorization and OS isolation. Tests or AST checks are not isolation. AppContainer and Job Object constrain execution but do not prove semantic correctness or make arbitrary generated code safe.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
