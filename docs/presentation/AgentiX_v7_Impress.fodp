     <draw:frame draw:name="Speaker notes" draw:style-name="gr8" draw:text-style-name="P13" draw:layer="layout" svg:width="24cm" svg:height="12cm" svg:x="1cm" svg:y="1cm">
      <draw:text-box>
       <text:p text:style-name="P8"><text:span text:style-name="T5">Timing: 00:50. Walk through the lifecycle. Generated artifacts are not automatically published or authorized. Approved artifacts are reusable only under current content, policy, and dependency checks. Human approval is a control, not proof of correctness.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
