     <draw:frame draw:name="Speaker notes" draw:style-name="gr8" draw:text-style-name="P13" draw:layer="layout" svg:width="24cm" svg:height="12cm" svg:x="1cm" svg:y="1cm">
      <draw:text-box>
       <text:p text:style-name="P8"><text:span text:style-name="T5">Timing: 00:15. Introduce AgentiX as a human-supervised approach to AI-assisted software development. The abstract motif is editable and not a project logo.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="Slide 02" draw:style-name="dp3" draw:master-page-name="Predeterminado">
    <draw:rect draw:name="Editable dark background" draw:style-name="gr3" draw:text-style-name="P7" draw:layer="layout" svg:width="28.222cm" svg:height="15.875cm" svg:x="0cm" svg:y="0cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Section label" draw:style-name="gr6" draw:text-style-name="P11" draw:layer="layout" svg:width="24.5cm" svg:height="0.693cm" svg:x="1.35cm" svg:y="0.55cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T4">THE PROBLEM</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Slide title" draw:style-name="gr9" draw:text-style-name="P14" draw:layer="layout" svg:width="25cm" svg:height="1.478cm" svg:x="1.35cm" svg:y="1.1cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T6">Generated code is easy to produce—and hard to govern</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Footer" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="24cm" svg:height="0.693cm" svg:x="1.35cm" svg:y="15.1cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">THE GLASS BOX AI PROJECT / AGENTIX V7</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Slide number" draw:style-name="gr6" draw:text-style-name="P15" draw:layer="layout" svg:width="0.9cm" svg:height="0.693cm" svg:x="26cm" svg:y="15.05cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T7">02</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:rect draw:name="Editable card" draw:style-name="gr10" draw:text-style-name="P16" draw:layer="layout" svg:width="12.1cm" svg:height="8.2cm" svg:x="1.35cm" svg:y="3cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Editable card title" draw:style-name="gr11" draw:text-style-name="P17" draw:layer="layout" svg:width="11.4cm" svg:height="0.84cm" svg:x="1.7cm" svg:y="3.25cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T8">A CODE DROP</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Editable card body" draw:style-name="gr12" draw:text-style-name="P18" draw:layer="layout" svg:width="11.4cm" svg:height="7cm" svg:x="1.7cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Large generated bundle</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Review burden</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Dependency sprawl</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Limited reuse</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Unclear run boundary</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Maintainability risk</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:rect draw:name="Editable card" draw:style-name="gr13" draw:text-style-name="P19" draw:layer="layout" svg:width="12.1cm" svg:height="8.2cm" svg:x="14.7cm" svg:y="3cm">
     <text:p/>
    </draw:rect>
    <draw:frame draw:name="Editable card title" draw:style-name="gr14" draw:text-style-name="P20" draw:layer="layout" svg:width="11.4cm" svg:height="0.889cm" svg:x="15.05cm" svg:y="3.25cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T9">AN ENGINEERED LIFECYCLE</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Editable card body" draw:style-name="gr12" draw:text-style-name="P18" draw:layer="layout" svg:width="11.4cm" svg:height="7cm" svg:x="15.05cm" svg:y="4cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Requirements</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Inspectable artifacts</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Human review</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Explicit acceptance</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Approved catalog</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T5">Controlled reuse</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Caveat" draw:style-name="gr15" draw:text-style-name="P22" draw:layer="layout" svg:width="24cm" svg:height="0.8cm" svg:x="2cm" svg:y="12.1cm">
     <draw:text-box>
      <text:p text:style-name="P21"><text:span text:style-name="T10">These are recurring risk patterns, not a claim that every AI-assisted workflow behaves the same way.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:frame draw:name="Speaker notes" draw:style-name="gr8" draw:text-style-name="P13" draw:layer="layout" svg:width="24cm" svg:height="12cm" svg:x="1cm" svg:y="1cm">
      <draw:text-box>
       <text:p text:style-name="P8"><text:span text:style-name="T5">Timing: 00:50. Frame the problem as a workflow challenge rather than a criticism of code generation. Large output is difficult to inspect; dependencies and runtime boundaries can be unclear; artifacts may be recreated rather than reused. Controls manage risk but do not eliminate it.</text:span></text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
